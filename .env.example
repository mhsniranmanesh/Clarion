# Anthropic API key (prompt structuring — default backend)
ANTHROPIC_API_KEY=

# OpenAI API key (Whisper speech-to-text, cloud mode)
OPENAI_API_KEY=

# Cohere API key (alternative structuring backend — Command and Tiny Aya models)
# Free trial keys: https://dashboard.cohere.com/api-keys
# Trial keys are capped at 20 calls/min and 1,000 calls/month — enough to try the app,
# not enough for a full eval run. See eval/README.md.
COHERE_API_KEY=

# ── Optional: local signed builds ────────────────────────────────────────────
# Only needed if you run `npm run tauri:build` and want a signed, notarized app.
# CI reads these from GitHub Actions secrets instead; see the Releasing section
# of README.md. Leave unset to produce an unsigned build.
# APPLE_SIGNING_IDENTITY=
# APPLE_ID=
# APPLE_PASSWORD=
# APPLE_TEAM_ID=
