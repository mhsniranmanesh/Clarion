{
  "name": "clarion",
  "version": "0.1.0",
  "description": "Voice-to-prompt preprocessor — speak naturally in any language, get well-structured English prompts for AI tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clarion": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest"
  },
  "keywords": [
    "voice",
    "speech-to-text",
    "prompt-engineering",
    "multilingual",
    "ai",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
